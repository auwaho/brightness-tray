<Window x:Class="BrightnessTray.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:BrightnessTray.App.Controls"
        Title="BrightnessTray">
  <Grid x:Name="FlyoutRoot" Width="380" Background="Transparent"
        KeyDown="Root_KeyDown">
    <Border x:Name="SurfaceBorder" Background="Transparent" CornerRadius="8">
      <Grid x:Name="LayoutRoot" Width="380">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- WinUI's outer thumb border extends 2 DIP beyond each side of the thumb. -->
            <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="FooterTintBrush" Color="#30000000" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="#48000000" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="#18FFFFFF" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="FooterTintBrush" Color="#0A000000" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="#24000000" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#18000000" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="#14000000" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="FooterTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
              </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
          </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <SystemBackdropElement x:Name="PanelBackdrop" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Grid x:Name="GrainHost" Grid.RowSpan="2" IsHitTestVisible="False" />
        <ScrollViewer x:Name="DisplayScroller" Margin="24,24,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
          <StackPanel Spacing="12">
            <ItemsControl x:Name="DisplayList" ItemsSource="{Binding Displays}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="DisplayCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                          BorderBrush="{ThemeResource DisplayCardStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueLabel}" FontWeight="SemiBold" />
                      </Grid>
                      <Grid Background="Transparent" ToolTipService.ToolTip="{Binding UnavailableReason}">
                        <controls:BrightnessSlider Style="{StaticResource DefaultSliderStyle}" Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsAvailable}" IsHitTestVisible="{Binding IsAvailable}"
                                StepFrequency="1" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding UnavailableReason}" />
                      </Grid>
                      <TextBlock Text="{Binding ConnectionLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding Name}" Message="{Binding Message}" Margin="0,0,0,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border x:Name="FooterPanel" Grid.Row="1" Height="50" Padding="16,0" CornerRadius="0,0,8,8"
                Background="{ThemeResource FooterTintBrush}"
                BorderBrush="{ThemeResource FooterDividerBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Text="{Binding Status}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Width="36" Height="36" Padding="0"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}"
                  AutomationProperties.Name="Update displays" ToolTipService.ToolTip="Update displays">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
          </Grid>
        </Border>
        <Border x:Name="SurfaceStroke" Grid.RowSpan="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource FlyoutStrokeBrush}" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
