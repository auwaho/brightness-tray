<Window x:Class="BrightnessTray.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:BrightnessTray.App.Controls"
        Title="BrightnessTray">
  <Grid x:Name="FlyoutRoot" Width="360" Background="Transparent"
        KeyDown="Root_KeyDown">
    <Border x:Name="SurfaceBorder" Background="Transparent" CornerRadius="8">
      <Grid x:Name="LayoutRoot" Width="360">
        <Grid.Resources>
          <ResourceDictionary>
            <Style x:Key="TrayMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
              <Setter Property="Height" Value="28" />
              <Setter Property="MinHeight" Value="28" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Padding" Value="10,0" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="UseSystemFocusVisuals" Value="False" />
              <Setter Property="FontSize" Value="13" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- WinUI's outer thumb border extends 2 DIP beyond each side of the thumb. -->
            <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="OpaqueBackdropBrush" Color="#242424" />
                <SolidColorBrush x:Key="DisplayCardFillBrush" Color="#0FFFFFFF" />
                <SolidColorBrush x:Key="AcrylicDensityBrush" Color="#202020" Opacity="0.20" />
                <SolidColorBrush x:Key="FooterTintBrush" Color="#39000000" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="#4E000000" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#14FFFFFF" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="#18FFFFFF" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="OpaqueBackdropBrush" Color="#F3F3F3" />
                <SolidColorBrush x:Key="DisplayCardFillBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
                <SolidColorBrush x:Key="AcrylicDensityBrush" Color="#F3F3F3" Opacity="0.20" />
                <SolidColorBrush x:Key="FooterTintBrush" Color="#0A000000" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="#24000000" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#18000000" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="#14000000" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="OpaqueBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="DisplayCardFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="AcrylicDensityBrush" Color="Transparent" />
                <SolidColorBrush x:Key="FooterTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="FooterDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="DisplayCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
              </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
          </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <SystemBackdropElement x:Name="PanelBackdrop" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Border x:Name="OpaqueBackdrop" Grid.RowSpan="2" Background="{ThemeResource OpaqueBackdropBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
        <Grid x:Name="GrainHost" Grid.RowSpan="2" Background="{ThemeResource AcrylicDensityBrush}" IsHitTestVisible="False" />
        <StackPanel x:Name="TrayMenuPanel" Grid.RowSpan="2" Padding="4" Visibility="Collapsed" KeyDown="TrayMenu_KeyDown"
                    TabFocusNavigation="Cycle" GotFocus="TrayMenu_GotFocus" LostFocus="TrayMenu_LostFocus">
          <Button x:Name="MenuOpenButton" Style="{StaticResource TrayMenuButtonStyle}" Tag="Open" Click="TrayMenu_Click" PointerEntered="TrayMenu_PointerEntered" AutomationProperties.Name="Open brightness">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Viewbox Width="18" Height="18" Margin="-1,0" VerticalAlignment="Center">
                <Path Width="32" Height="32" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M23.5,16 A7.5,7.5 0 1 0 8.5,16 A7.5,7.5 0 1 0 23.5,16 M28.5,16 L30.5,16 M24.839,24.839 L26.253,26.253 M16,28.5 L16,30.5 M7.161,24.839 L5.747,26.253 M3.5,16 L1.5,16 M7.161,7.161 L5.747,5.747 M16,3.5 L16,1.5 M24.839,7.161 L26.253,5.747" />
              </Viewbox>
              <TextBlock Grid.Column="1" Text="Open brightness" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="MenuRefreshButton" Style="{StaticResource TrayMenuButtonStyle}" Tag="Refresh" Click="TrayMenu_Click" PointerEntered="TrayMenu_PointerEntered" AutomationProperties.Name="Refresh displays">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE72C;" FontSize="16" />
              <TextBlock Grid.Column="1" Text="Refresh displays" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Border Height="1" Margin="8,3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid x:Name="MenuStartupHost" Background="Transparent">
            <Button x:Name="MenuStartupButton" Style="{StaticResource TrayMenuButtonStyle}" IsEnabled="False" Tag="Startup" Click="TrayMenu_Click" PointerEntered="TrayMenu_PointerEntered" AutomationProperties.Name="Start with Windows">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                <Path x:Name="MenuStartupIcon" Width="16" Height="16" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                      Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z" />
                <TextBlock Grid.Column="1" Text="Start with Windows" VerticalAlignment="Center" />
                <FontIcon x:Name="MenuStartupCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed" />
              </Grid>
            </Button>
          </Grid>
          <Border Height="1" Margin="8,3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Button x:Name="MenuExitButton" Style="{StaticResource TrayMenuButtonStyle}" Tag="Exit" Click="TrayMenu_Click" PointerEntered="TrayMenu_PointerEntered" AutomationProperties.Name="Exit">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8BB;" FontSize="14" />
              <TextBlock Grid.Column="1" Text="Exit" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
        <ScrollViewer x:Name="DisplayScroller" Margin="24,24,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
          <StackPanel Spacing="12">
            <ItemsControl x:Name="DisplayList" ItemsSource="{Binding Displays}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="DisplayCard" Background="{ThemeResource DisplayCardFillBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                          BorderBrush="{ThemeResource DisplayCardStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding ValueLabel}" FontWeight="SemiBold" />
                      </Grid>
                      <Grid Background="Transparent" ToolTipService.ToolTip="{Binding UnavailableReason}">
                        <controls:BrightnessSlider Style="{StaticResource DefaultSliderStyle}" Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsAvailable}" IsHitTestVisible="{Binding IsAvailable}"
                                StepFrequency="1" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding UnavailableReason}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding Name}" Message="{Binding Message}" Margin="0,0,0,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border x:Name="FooterPanel" Grid.Row="1" Height="50" Padding="16,0" CornerRadius="0,0,8,8"
                Background="{ThemeResource FooterTintBrush}"
                BorderBrush="{ThemeResource FooterDividerBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Text="{Binding Status}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Width="36" Height="36" Padding="0"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}"
                  AutomationProperties.Name="Update displays" ToolTipService.ToolTip="Update displays">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
          </Grid>
        </Border>
        <Border x:Name="SurfaceStroke" Grid.RowSpan="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource FlyoutStrokeBrush}" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
