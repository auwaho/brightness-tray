<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BrightnessTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(BrightnessTrayStoreBuild)' != 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(BrightnessTrayStoreBuild)' == 'true'">false</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BrightnessTrayStoreBuild)' == 'true'">
    <!-- The manually generated MSIX declares the framework in its static package graph. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>true</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="Assets\Grain.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The tray menu and NativeWindow need WinForms references; its SDK would replace WinUI's XAML targets. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <!-- Keep the existing UI/runtime versions without the unused AI, ML, Search and Widgets components. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" Condition="'$(BrightnessTrayStoreBuild)' == 'true'" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ProjectReference Include="../BrightnessTray.Core/BrightnessTray.Core.csproj" />
    <ProjectReference Include="../BrightnessTray.Windows/BrightnessTray.Windows.csproj" />
  </ItemGroup>
  <!-- The WinUI SDK copies XAML/PRI resources to build output but does not add them to dotnet publish. -->
  <Target Name="IncludeWinUIResourcesForPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI resource index is missing from build output." />
    <ItemGroup>
      <_WinUIResourcesForPublish Include="$(TargetDir)**/*.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <AssignTargetPath Files="@(_WinUIResourcesForPublish)" RootFolder="$(TargetDir)">
      <Output TaskParameter="AssignedFiles" ItemName="_WinUIResourcesWithTargetPath" />
    </AssignTargetPath>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_WinUIResourcesWithTargetPath)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_WinUIResourcesWithTargetPath.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
