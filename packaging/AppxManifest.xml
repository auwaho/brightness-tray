<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="BrightnessTray" Publisher="CN=BrightnessTray Development"
            Version="0.1.3.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>BrightnessTray</DisplayName>
    <PublisherDisplayName>BrightnessTray</PublisherDisplayName>
    <Description>Control brightness for each supported display from the system tray.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="BrightnessTray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="BrightnessTray"
                          Description="Control brightness for each supported display."
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="#292929" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="BrightnessTray.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="BrightnessTrayStartup" Enabled="false" DisplayName="BrightnessTray" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
