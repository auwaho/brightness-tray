<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../../src/BrightnessTray.App/app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(BrightnessTrayStoreBuild)' != 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(BrightnessTrayStoreBuild)' == 'true'">false</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../src/BrightnessTray.App/Assets/Grain.png" Link="Assets/Grain.png" CopyToOutputDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- Unpackaged UI checks use the bootstrapper against an already installed shared runtime. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" Condition="'$(BrightnessTrayStoreBuild)' == 'true'" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ProjectReference Include="../../src/BrightnessTray.Core/BrightnessTray.Core.csproj" />
    <ProjectReference Include="../../src/BrightnessTray.Windows/BrightnessTray.Windows.csproj" />
    <!-- Compile the actual UI sources; test entry point and virtual devices remain outside src. -->
    <Compile Include="../../src/BrightnessTray.App/**/*.cs"
             Exclude="../../src/BrightnessTray.App/App.xaml.cs;../../src/BrightnessTray.App/obj/**/*.cs;../../src/BrightnessTray.App/bin/**/*.cs"
             LinkBase="App" />
    <ApplicationDefinition Include="../../src/BrightnessTray.App/App.xaml" Link="App.xaml" />
    <Page Include="../../src/BrightnessTray.App/FlyoutWindow.xaml" Link="FlyoutWindow.xaml" />
  </ItemGroup>
</Project>
